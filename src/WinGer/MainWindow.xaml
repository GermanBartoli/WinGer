<Window x:Class="WinGer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinGer">
  <Grid x:Name="Raiz" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.Resources>
      <DataTemplate x:Key="TarjetaPaquete">
        <Border Width="365" Padding="16" Margin="0,0,10,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Ver en VirusTotal · sin API" Tag="{Binding}" Click="AbrirInformeWeb"/><MenuFlyoutItem Text="Consultar informe existente · API" Tag="{Binding}" Click="AnalizarPaquete"/><MenuFlyoutItem Text="Comprobar y actualizar…" Tag="{Binding}" Click="ActualizarPaquete"/><MenuFlyoutItem Text="Ver detalles" Tag="{Binding}" Click="DetallesPaquete"/></MenuFlyout></Border.ContextFlyout>
          <StackPanel Spacing="8">
            <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}" Content="{Binding Nombre}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Id}" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Instalada}"/><TextBlock Text="→"/><TextBlock Text="{Binding Disponible}" FontWeight="SemiBold"/></StackPanel>
            <TextBlock Text="{Binding Estado}" TextWrapping="Wrap" Foreground="{Binding Color}" MinHeight="38"/>
            <StackPanel Spacing="3" Margin="0,0,0,4">
              <TextBlock Text="{Binding LineaApi}" Foreground="{Binding ColorApi}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding LineaVtai}" Foreground="{Binding ColorVtai}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding LineaWeb}" Foreground="{Binding ColorWeb}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Ver web" Tag="{Binding}" Click="AbrirInformeWeb"/><Button Content="Leer web · experimental" Tag="{Binding}" Click="LeerInformeWeb"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Consultar API" Tag="{Binding}" Click="AnalizarPaquete"/><Button Content="Actualizar" Tag="{Binding}" Click="ActualizarPaquete"/></StackPanel>
            <Button Content="Ver detalles / error" Tag="{Binding}" Click="DetallesPaquete" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
      </DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <NavigationView x:Name="Navegacion" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="CambiarSeccion" OpenPaneLength="230">
      <NavigationView.PaneHeader><StackPanel Margin="16,12,0,24" Spacing="4"><TextBlock Text="WinGer" FontSize="30" FontWeight="Bold"/><TextBlock Text="Actualizá con información" Opacity="0.65"/></StackPanel></NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Actualizaciones" Tag="actualizaciones" Icon="Download" IsSelected="True"/>
        <NavigationViewItem Content="Microsoft Store" Tag="store" Icon="Shop"/>
        <NavigationViewItem Content="VirusTotal" Tag="virus" Icon="ProtectedDocument"/>
        <NavigationViewItem Content="Historial" Tag="historial" Icon="Clock"/>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter><TextBlock Text="WinGer · Vista previa 0.3.2" Margin="16" Opacity="0.5"/></NavigationView.PaneFooter>
      <ScrollViewer><StackPanel x:Name="Contenido" Margin="32,24,32,32" Spacing="20" MaxWidth="1200" HorizontalAlignment="Stretch"/></ScrollViewer>
    </NavigationView>
    <Border Grid.Row="1" Padding="24,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressRing IsActive="{x:Bind Modelo.Ocupado, Mode=OneWay}" Width="20" Height="20"/><TextBlock Grid.Column="1" Text="{x:Bind Modelo.Estado, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="2" Content="Cancelar" Click="Cancelar" IsEnabled="{x:Bind Modelo.Ocupado, Mode=OneWay}"/></Grid></Border>
  </Grid>
</Window>
