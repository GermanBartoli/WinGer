<UserControl x:Class="WinGer.LimpiezaVista"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DataTemplate x:Key="ArchivoLimpieza">
      <Grid Padding="0,5" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding Tamano}"/>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Ruta}" Opacity="0.72" TextWrapping="Wrap" FontSize="12"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <TabView x:Name="Pestanas" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent"
           TabCloseRequested="CerrarPestana">
    <TabViewItem Header="Limpiador" IsClosable="False">
      <TabViewItem.IconSource><SymbolIconSource Symbol="Delete"/></TabViewItem.IconSource>
      <Grid Padding="1,14,1,1" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border CornerRadius="8" Padding="16,12" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
          <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TituloEstado" Text="Listo para analizar" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="Espacio" Grid.Column="1" Grid.RowSpan="2" FontSize="23" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="Estado" Grid.Row="1" Text="Elegí Analizar para calcular cuánto espacio ocupan los archivos." TextWrapping="Wrap" Opacity="0.75"/>
            <ProgressBar x:Name="Avance" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <Grid x:Name="Explorador" Grid.Row="1" ColumnSpacing="10" RowSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="AnchoMenu" Width="152"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Border x:Name="Menu" Grid.RowSpan="2" Padding="6,10" CornerRadius="8"
                  Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="7">
              <TextBlock Text="Categorías" Margin="8,0" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.75"/>
              <ListView x:Name="Familias" SelectionMode="Single" SelectionChanged="CambiarFamilia">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{Binding Icono}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                      <TextBlock Text="{Binding Nombre}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Border>
          <ComboBox x:Name="FamiliasCompactas" Grid.ColumnSpan="2" Visibility="Collapsed"
                    SelectionChanged="CambiarFamilia" AutomationProperties.Name="Filtrar por categoría"/>
          <Border x:Name="Resultados" Grid.Column="1" Grid.RowSpan="2" Padding="10" CornerRadius="8" BorderThickness="1"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="4">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
              <Grid Padding="40,5,18,8" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                <TextBlock Text="Nombre" Opacity="0.7"/>
                <TextBlock Grid.Column="1" Text="Archivos" HorizontalAlignment="Right" Opacity="0.7"/>
                <TextBlock Grid.Column="2" Text="Tamaño" HorizontalAlignment="Right" Opacity="0.7"/>
              </Grid>
              <ScrollViewer x:Name="ListaResultados" Grid.Row="1" Height="280" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                <StackPanel x:Name="Filas" Margin="0,0,14,0" Spacing="1"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="Acciones" Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Seleccion" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button x:Name="Analizar" Grid.Column="1" Content="Analizar" Style="{StaticResource AccentButtonStyle}" Click="IniciarAnalisis"/>
          <Button x:Name="Borrar" Grid.Column="2" Content="Borrar selección…" IsEnabled="False" Click="BorrarSeleccion"/>
        </Grid>
      </Grid>
    </TabViewItem>
    <TabViewItem Header="Apariencia" IsClosable="False">
      <TabViewItem.IconSource><SymbolIconSource Symbol="Setting"/></TabViewItem.IconSource>
      <StackPanel x:Name="Opciones" Padding="12,16" Spacing="12"/>
    </TabViewItem>
  </TabView>
</UserControl>
